    shutil.rmtree(FRAMES_DIR, ignore_errors=True)
    os.makedirs(FRAMES_DIR, exist_ok=True)

    cap = cv2.VideoCapture(video_path)

    index = 0

    while True:

        ret, frame = cap.read()

        if not ret:
            break

